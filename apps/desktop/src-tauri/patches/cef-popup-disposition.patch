+fn send_message_to_event_loop<T: UserEvent>(
+  sender: &Sender<Message<T>>,
+  message: Message<T>,
+) -> Result<()> {
+  if let Err(error) = sender.send(message) {
+    match error.0 {
+      // The main-thread loop is gone; a task may own native resources that cannot be dropped here.
+      Message::Task(task) => std::mem::forget(task),
+      message => drop(message),
+    }
+    return Err(Error::FailedToSendMessage);
+  }
+  Ok(())
+}
