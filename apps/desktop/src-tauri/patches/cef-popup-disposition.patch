+#[cfg(test)]
+mod eval_registration_tests {
+  use super::{complete_eval_callback, release_eval_registration};
+  use std::sync::{
+    Arc, Mutex, Weak,
+    atomic::{AtomicUsize, Ordering},
+  };
+
+  struct RegistrationProbe {
+    slot: Weak<Mutex<Option<RegistrationProbe>>>,
+    drops: Arc<AtomicUsize>,
+    _observer_owner: Option<Arc<Mutex<Option<RegistrationProbe>>>>,
+  }
+
+  impl Drop for RegistrationProbe {
+    fn drop(&mut self) {
+      let slot = self
+        .slot
+        .upgrade()
+        .expect("registration storage must remain alive");
+      assert!(
+        slot.try_lock().is_ok(),
+        "registration must be dropped after unlocking its storage"
+      );
+      self.drops.fetch_add(1, Ordering::SeqCst);
+    }
+  }
+
+  #[test]
+  fn registration_is_released_once_without_holding_its_storage_lock() {
+    let slot = Arc::new(Mutex::new(None));
+    let drops = Arc::new(AtomicUsize::new(0));
+    *slot.lock().unwrap() = Some(RegistrationProbe {
+      slot: Arc::downgrade(&slot),
+      drops: Arc::clone(&drops),
+      _observer_owner: None,
+    });
+
+    release_eval_registration(&slot);
+    release_eval_registration(&slot);
+    assert_eq!(drops.load(Ordering::SeqCst), 1);
+    assert!(slot.lock().unwrap().is_none());
+  }
+
+  #[test]
+  fn callback_can_close_its_owner_before_cleanup_is_queued() {
+    let slot = Arc::new(Mutex::new(None));
+    let drops = Arc::new(AtomicUsize::new(0));
+    *slot.lock().unwrap() = Some(RegistrationProbe {
+      slot: Arc::downgrade(&slot),
+      drops: Arc::clone(&drops),
+      _observer_owner: None,
+    });
+    let weak = Arc::downgrade(&slot);
+    let callback_finished = std::cell::Cell::new(false);
+    let queued = std::cell::RefCell::new(None);
+    let retained = Arc::clone(&slot);
+    assert!(complete_eval_callback(
+      retained,
+      || {
+        drop(slot);
+        assert!(weak.upgrade().is_some());
+        assert_eq!(drops.load(Ordering::SeqCst), 0);
+        assert!(queued.borrow().is_none());
+        callback_finished.set(true);
+      },
+      |registration| {
+        assert!(callback_finished.get());
+        *queued.borrow_mut() = Some(registration);
+        true
+      }
+    ));
+    assert_eq!(drops.load(Ordering::SeqCst), 0);
+    let queued = queued.into_inner().unwrap();
+    release_eval_registration(&queued);
+    assert_eq!(drops.load(Ordering::SeqCst), 1);
+    drop(queued);
+    assert!(weak.upgrade().is_none());
+  }
