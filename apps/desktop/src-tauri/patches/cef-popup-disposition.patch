+fn release_eval_registration<T>(registration: &Mutex<Option<T>>) {
+  let registration = registration.lock().unwrap().take();
+  drop(registration);
+}
+
+fn complete_eval_callback<T>(
+  registration: Arc<Mutex<Option<T>>>,
+  callback: impl FnOnce(),
+  post_cleanup: impl FnOnce(Arc<Mutex<Option<T>>>) -> bool,
+) -> bool {
+  callback();
+  post_cleanup(registration)
+}
+
+wrap_task! {
+  struct ReleaseEvalRegistrationTask {
+    registration: Arc<Mutex<Option<cef::Registration>>>,
+  }
+
+  impl Task {
+    fn execute(&self) {
+      release_eval_registration(&self.registration);
+    }
+  }
+}
