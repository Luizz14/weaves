+
+  #[derive(Clone, Debug)]
+  struct DropProbe(Arc<AtomicBool>);
+
+  impl Drop for DropProbe {
+    fn drop(&mut self) {
+      self.0.store(true, Ordering::Release);
+    }
+  }
+
+  #[test]
+  fn closed_channel_leaks_tasks_and_drops_other_messages() {
+    let (sender, receiver) = mpsc::channel();
+    drop(receiver);
+
+    let task_dropped = Arc::new(AtomicBool::new(false));
+    let task_probe = DropProbe(task_dropped.clone());
+    assert!(matches!(
+      send_message_to_event_loop(&sender, Message::Task(Box::new(move || drop(task_probe)))),
+      Err(Error::FailedToSendMessage)
+    ));
+    assert!(!task_dropped.load(Ordering::Acquire));
+
+    let event_dropped = Arc::new(AtomicBool::new(false));
+    assert!(matches!(
+      send_message_to_event_loop(
+        &sender,
+        Message::UserEvent(DropProbe(event_dropped.clone()))
+      ),
+      Err(Error::FailedToSendMessage)
+    ));
+    assert!(event_dropped.load(Ordering::Acquire));
+  }
+}
