{
	"extends": "@superset/typescript/base.json",
	"compilerOptions": {
		"types": ["bun"],
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noUncheckedIndexedAccess": false,
		"paths": {
			"@superset/chat-runtime": ["../../packages/chat-runtime/src/index.ts"],
			"*": ["./src/*"],
			"~/*": ["./*"]
		}
	},
	"include": [
		"./src",
		"vite.config.ts",
		"vite.renderer.config.ts",
		"index.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"release",
		"src/**/templates/**",
		"src/resources/browser-extension"
	]
}
